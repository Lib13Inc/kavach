# Homelab target for the Kavach demo. Sourced by every script in this directory.

# Proxmox host (ssh as root) and the VM to build on it.
PVE_HOST=root@minipve.lab.local
VMID=130
VM_NAME=kavach-demo
TEMPLATE_VMID=9000            # ubuntu-2404-cloud-template
STORAGE=local-lvm
BRIDGE=vmbr0
CORES=4
MEMORY_MB=8192
DISK_SIZE=40G

# Static address on the lab LAN.
VM_IP=172.16.0.170
VM_CIDR=24
VM_GW=172.16.0.1
VM_DNS=172.16.0.1
VM_USER=ubuntu
SSH_PUBKEY=$HOME/.ssh/id_ed25519.pub

# Local model: llama.cpp llama-server (OpenAI-compatible) in the ai-inference LXC on minipve2.
# Its address must match the host added in policy/payments-homelab.yaml.
LLM_BASE_URL=http://172.16.0.44:8080/v1
LLM_MODEL=qwen3-30b-a3b

# Stage demo UI (demo/server.py) on the VM: http://$VM_IP:$TRACE_PORT/ (trace viewer at /trace-view/)
TRACE_PORT=8088

# Tailnet name for the VM; tailscale.sh serves the demo at https://$TS_HOSTNAME.$TAILNET/
TS_HOSTNAME=kavach-demo
TAILNET=bettong-beta.ts.net
