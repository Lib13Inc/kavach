# Kavach demo on Crusoe Cloud: a CPU VM running the whole stack, with Crusoe Managed Inference
# (Crusoe's Qwen) as the model. Sourced by every script in this directory.

# Credentials come from this file at call time; nothing is written to ~/.crusoe or the repo.
#   CRUSOE_ACCESS_KEY / CRUSOE_SECRET_KEY   Crusoe Cloud API (VMs)
#   CRUSOE_AI_KEY                           Crusoe Managed Inference (the model)
SECRETS_FILE=$HOME/.env.secrets

# VM: c1a.4x = 4 vCPU / 16 GB, about $0.16/hour on demand ($0.04 per vCPU-hour).
VM_NAME=kavach-crusoe
VM_TYPE=c1a.4x
LOCATION=us-east1-a            # also: us-southcentral1-a, eu-iceland1-a
IMAGE=ubuntu22.04:latest       # the only plain x86 Ubuntu image Crusoe offers
VM_USER=ubuntu
SSH_PUBKEY=$HOME/.ssh/id_ed25519.pub

# Model: Crusoe Managed Inference (OpenAI-compatible).
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_MODEL=Qwen/Qwen3.8-27B

# eBPF guard needs bpftrace >= 0.16; Ubuntu 22.04 ships 0.14, so provision.sh installs this static build.
BPFTRACE_URL=https://github.com/bpftrace/bpftrace/releases/download/v0.27.0/bpftrace-x86_64

# Stage demo UI on the VM. Port 8088 is NOT opened in Crusoe's firewall (only SSH is);
# reach it over the tailnet (tailscale.sh) or an SSH tunnel (./tunnel.sh).
DEMO_PORT=8088
TS_HOSTNAME=kavach-crusoe
TAILNET=bettong-beta.ts.net
