# Copy to .env (scripts/setup-host.sh does this). Never commit .env.
# Real model keys: only the gateway container receives these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible endpoint/model for --model openai (e.g. a local llama.cpp server).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Per-request timeout for the agent's HTTP client (seconds); raise for slow local models.
KAVACH_HTTP_TIMEOUT=20
# Seconds the contained agent waits before starting, so `sudo ebpf/guard.sh` can attach first.
KAVACH_START_DELAY=0
